# ---------------------------------------------------------------------------
# BACKEND ONLY. These values are never shipped inside the Python package.
# Copy to backend/.env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# Which transactional email provider to use: resend | sendgrid | postmark | smtp
EMAIL_PROVIDER=resend

# The provider API key (secret).
EMAIL_PROVIDER_API_KEY=your_key_here

# Where the message is delivered. Configured server-side ONLY.
# The CLI can never choose or override the recipient.
RECIPIENT_EMAIL=your_email_here

# Verified "from" address on your provider's domain.
SENDER_EMAIL=raksha@your-verified-domain.com
SENDER_NAME=Raksha Surprise CLI

# Abuse protection
MAX_MESSAGE_LENGTH=2000
RATE_LIMIT_PER_IP_PER_HOUR=5
RATE_LIMIT_GLOBAL_PER_HOUR=60

# Optional: comma-separated origins allowed to call the API (empty = any).
ALLOWED_ORIGINS=

# SMTP fallback provider (only used when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
